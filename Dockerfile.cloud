# termany.ai — the hosted web client (apps/cloud gateway + the cloud build of apps/web).
# Build from the repo root:  docker build -f Dockerfile.cloud -t termany-web .

FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/web ./apps/web
COPY apps/cloud ./apps/cloud
# The other workspaces' manifests keep the lockfile consistent; their code is not needed.
COPY apps/server/package.json ./apps/server/
COPY apps/desktop/package.json ./apps/desktop/
# Only the two workspaces this image needs (plus their workspace deps); no
# install scripts, so node-pty & co. are never built.
RUN npm ci --ignore-scripts --no-audit --no-fund -w @termany/web -w @termany/cloud
ENV NODE_OPTIONS=--max-old-space-size=3072
RUN npm -w @termany/web run build:cloud && npm -w @termany/cloud run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=8080 STATIC_DIR=/app/public
COPY --from=build /src/apps/cloud/dist/server.cjs ./server.cjs
COPY --from=build /src/apps/web/dist-cloud ./public
USER node
EXPOSE 8080
CMD ["node", "server.cjs"]
