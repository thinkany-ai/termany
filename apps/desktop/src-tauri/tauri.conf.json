{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Termany",
  "version": "0.1.30",
  "identifier": "ai.termany.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:15173"
  },
  "app": {
    "windows": [
      {
        "title": "Termany",
        "width": 1280,
        "height": 832,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cdn.termany.sh/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNEEzMThGQjBFOUFBMTQKUldRVXF1bXdqekZLRTRDV3NsMlZ2aWIraFllbW5KWExyWmlBcmgwaE1kMFl2clgyaDYxN2lhZXIK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
